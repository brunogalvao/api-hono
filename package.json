{
  "name": "api-hono",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx dev.ts",
    "build": "echo 'Build completed'",
    "start": "node dist/app.js",
    "vercel-build": "echo 'Build completed'",
    "test": "vitest run",
    "test:smoke": "API_URL=https://api-hono-jet.vercel.app vitest run tests/smoke.test.ts",
    "load:public": "k6 run --env PROFILE=smoke load-tests/scenarios/public.js",
    "load:auth": "k6 run --env PROFILE=smoke --env LOAD_TEST_TOKEN=$LOAD_TEST_TOKEN load-tests/scenarios/authenticated.js",
    "load:ia": "k6 run --env LOAD_TEST_TOKEN=$LOAD_TEST_TOKEN load-tests/scenarios/ia.js",
    "load:all": "pnpm load:public && pnpm load:auth && pnpm load:ia"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-openapi": "^0.19.6",
    "@hono/zod-validator": "^0.7.2",
    "@supabase/supabase-js": "^2.49.4",
    "dotenv": "^16.3.1",
    "hono": "^4.7.9",
    "hono-openapi": "^0.4.8",
    "openai": "^5.8.2",
    "resend": "^6.12.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.2.14",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
