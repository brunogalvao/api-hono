{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/workspaces/:workspaceId/invites/:inviteId/resend",
      "destination": "/api/workspace-invites-admin?operation=resend&workspaceId=:workspaceId&inviteId=:inviteId"
    },
    {
      "source": "/api/workspaces/:workspaceId/invites/:inviteId",
      "destination": "/api/workspace-invites-admin?operation=cancel&workspaceId=:workspaceId&inviteId=:inviteId"
    },
    {
      "source": "/api/workspaces/:workspaceId/invites",
      "destination": "/api/workspace-invites-admin?operation=create&workspaceId=:workspaceId"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
} 
